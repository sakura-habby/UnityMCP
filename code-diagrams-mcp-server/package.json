{
  "name": "code-diagrams-mcp-server",
  "version": "0.1.0",
  "description": "MCPServer for code diagrams",
  "private": true,
  "type": "module",
  "bin": {
    "code-diagrams-mcp-server": "./build/index.js"
  },
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { chmod } from 'fs/promises'; await chmod('build/index.js', '755');\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "tree-sitter": "^0.20.6",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.25.3",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@mapbox/node-pre-gyp": "^2.0.0",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  }
}
